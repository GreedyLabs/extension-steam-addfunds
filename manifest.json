{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "ko",
  "author": "GreedyLabs",
  "homepage_url": "https://github.com/GreedyLabs/extension-steam-addfunds",
  "browser_specific_settings": {
    "gecko": {
      "id": "steam-addfunds@greedylabs.kr",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/steamaccount/addfunds*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.steampowered.com/cart*"],
      "css": ["styles.css"],
      "js": ["cart.js"],
      "run_at": "document_idle"
    }
  ]
}
